# =========================================================
# 로컬 전용 배포 프리셋 (.env.local)
# — 클라우드 의존성 0, 완전 오프라인 동작.
# 사용: cp .env.local.template .env.local  후 값 채우기
#       docker compose -f docker-compose.local.yml --env-file .env.local up -d
#
# ★ 클라우드 키는 모두 비워둠(자동降级 stub).
# ★ LLM 은 Ollama 로컬 모델 사용(본인 PC 에 ollama + 모델 설치 필요).
# =========================================================

# ---- LLM (로컬) ----
# Ollama 설치 후:  ollama pull qwen2.5:7b   (또는 qwen2.5:14b)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_FALLBACK_ENABLED=false          # 로컬 모드에서는 외부 폴백 비활성(완전 오프라인)
LLM_FALLBACK_CHAIN=

# ---- Embedder (로컬 모델, 오프라인) ----
EMBEDDER=kure
EMBEDDER_LIST=kure,bge_m3

# ---- Vector DB (embedded, 단일 프로세스) ----
QDRANT_URL=local:./.qdrant_local
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=gospel_local

# ---- Reranker ----
RERANKER=none                        # 로컬 모드: reranker 모델 미로드(메모리 절약). 필요시 bge_m3

# ---- Retrieval ----
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# ---- Policy / Speed ----
POLICY_ENABLED=true
SALVATION_DETECTION_ENABLED=true
CLASSIFY_INPUT_ENABLED=true

# ---- Ingest ----
INGEST_NORMALIZE_ENABLED=true
INGEST_RESTRUCTURE_ENABLED=true
INGEST_CONTEXTUAL_ENABLED=true
INGEST_QUALITY_GATE_ENABLED=true
INGEST_CHUNK_TARGET_TOKENS=350
INGEST_CHUNK_MAX_TOKENS=512
INGEST_CHUNK_MIN_TOKENS=50

# ---- Welcome Verse ----
WELCOME_VERSE=하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 그를 믿는 자마다 멸망하지 않고 영생을 얻게 하려 하심이라
WELCOME_VERSE_REF=요한복음 3:16

# ---- Data & Logging ----
DATA_DIR=/app/data/documents
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100

# ---- 운영 모드 / 보안 ----
APP_ENV=local
DOCS_ENABLED=true                    # 로컬은 개발 편의로 /docs 열어둠
KRAI_PUBLIC_MODE=false
UVICORN_WORKERS=1                    # 로컬 PC 는 보통 2~4코어 → 워커 1

# ---- 외부 서비스 (전부 비활성/비움 = 자동降级) ----
LANGFUSE_ENABLED=false
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PUSH_ENABLED=false
RATE_LIMIT_ENABLED=false             # 로컬 단독 사용이므로 제한 해제
TOKEN_QUOTA_ENABLED=false
SUBSCRIPTION_ENABLED=false           # 로컬 데모: 결제/구독 플로우 비활성

# ---- uvicorn ----
PORT=8000
