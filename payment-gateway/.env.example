# System Configuration
PORT=5000
NODE_ENV=development

# Database Connections
DB_USER=neo_admin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL="postgresql://neo_admin:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/neo_db?schema=public"
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379"

# Security & Encryption Keys
# ALL secrets below MUST be replaced with cryptographically random values in production.
# Use: openssl rand -hex 32  (for 64-char hex keys)
# Use: openssl rand -base64 48 (for 64-char base64 secrets)

# JWT_SECRET: 32+ character cryptographically random string
JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_32PLUS_CHARS"

# KOREA_SECRET_SALT_KEY: Stable secret for deterministic UID hashing (do NOT change after users are created)
KOREA_SECRET_SALT_KEY="CHANGE_ME_GENERATE_RANDOM_32PLUS_CHARS"

# PII_ENCRYPTION_KEY: 32-byte hex-encoded string (64 hex chars, cryptographically random)
PII_ENCRYPTION_KEY="CHANGE_ME_GENERATE_64_HEX_CHARS_USE_openssl_rand_hex_32"
PII_HASH_PEPPER="CHANGE_ME_GENERATE_RANDOM_32PLUS_CHARS"

# SSO Signed Keys (HS256 shared secret for cross-border SSO token signing)
SSO_JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_32PLUS_CHARS"
SSO_REDIRECT_ALLOWLIST="https://china-worksite.example.com"

# External Integrations (PG, Tax, Cash Receipt, China Credit)
PG_API_SECRET_KEY="CHANGE_ME_YOUR_PG_SECRET_KEY"
TAX_INVOICE_API_KEY="CHANGE_ME_YOUR_TAX_API_KEY"
CHINA_CREDIT_API_URL="https://api.china-worksite.example.com/credit/topup"
CHINA_CREDIT_API_KEY="CHANGE_ME_YOUR_CHINA_CREDIT_API_KEY"

# Admin Credentials
ADMIN_EMAIL="piaoyhyh@gmail.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
# Set true ONLY to recover a locked-out admin: on next failed login that matches
# ADMIN_PASSWORD, the stored bcrypt hash is overwritten with ADMIN_PASSWORD.
# Set back to false (or remove) immediately after recovering. Never leave enabled in production.
ADMIN_PASSWORD_FORCE_SYNC=false

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
