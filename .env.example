LLM_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true
# 비우면 gemini 실패 시 키가 있는 openai/claude/ollama 순으로 재시도
LLM_FALLBACK_CHAIN=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat


EMBEDDER=kure
EMBEDDER_LIST=kure

# 옵션 A (단일 박스 docker-compose): embedded 대신 compose 의 qdrant 컨테이너 사용 → 아래를 비워두면
#   backend 가 http://qdrant:6333 로 자동 연결. (docker-compose.prod.yml 참조)
# 옵션 B (Qdrant Cloud / 서버 모드): 아래 URL + 키 채우기.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=gospel

# Reranker: bge_m3(로컬 CrossEncoder) 권장. 로드/메모리 실패 시 자동 NoOp 폴백(fail-open)으로 채팅 다운 없음.
RERANKER=bge_m3

RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# ── 성능 최적화 (RAG 응답 지연 개선) ──
# 벡터 검색 범위 축소: recall_k = max(top_k * RECALL_K_PER_TOPK, RECALL_K_FLOOR)
RECALL_K_FLOOR=80
RECALL_K_PER_TOPK=3
# 다중(확장) 쿼리별 recall 감쇠: 2번째 쿼리부터 탐색량 축소
MULTI_QUERY_RECALL_DECAY=0.6
# Qdrant ef_search 상한 (기존 256 → 128): 탐색 속도 향상
EF_SEARCH_CAP=128
# LLM 프롬프트 컨텍스트 토큰 예산 + 상위 K 문서 수
CONTEXT_MAX_TOKENS=900
CONTEXT_TOP_K=3
# LLM 최대 생성 토큰 (기존 1000 → 700): TTFT 이후 종료도 빨라짐
CHAT_MAX_TOKENS=700
# FAQ 정적 캐시 (자주 묻는 질문 사전 저장)
FAQ_CACHE_ENABLED=true
FAQ_CACHE_TTL_SEC=86400
FAQ_MIN_HITS=3


POLICY_ENABLED=true
POLICY_RULES_PATH=data/eval/policy_rules.yaml

# 근거 귀속(환각) 검증 / SourceGroundingVerifier
# - monitor(기본): 백그라운드 실행, 응답 지연 0, 점수만 로깅/모니터링
# - enforce: 동기 실행, 미통과 시 안전 응답으로 대체(스트림은 끝에 알림 append)
GROUNDING_VERIFY_ENABLED=true
GROUNDING_VERIFY_MODE=monitor
GROUNDING_VERIFY_TIMEOUT=4.0

# Rate Limiting (/chat 경로 IP 제한) — 2026-07-15부터 config.py에 매핑되어 적용됨
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

APP_PASSWORD=
ADMIN_API_KEY=change-me
DIFY_API_KEY=change-me
AUTH_SECRET=

# ── 운영 환경 분리 ──
# APP_ENV=prod → embedded Qdrant 사용 금지 안내 적용, 로깅/동작이 운영 모드.
APP_ENV=prod

# ── API 문서 노출 ──
# 운영/공개 배포에서는 false 로 설정해 /docs·/openapi.json 노출 차단 권장.
DOCS_ENABLED=false

# ── 공개 사이트(8501) 모드 ──
# 통합앱(8501)에서 관리자 진입/페이지를 완전 차단. true 면 사이드바 "⚙️ 관리자"
# 버튼이 사라지고 admin/admin_login 모드 및 모든 관리자 페이지 접근이 차단됨.
# 운영자 콘솔은 별도 관리자 허브(8502, admin/app.py)로 분리.
# ⚠️ 8502 관리자 허브는 이 값을 설정하지 않거나 false 여야 정상 동작.
#    8501 공개 배포 시 8501 프로세스만 KRAI_PUBLIC_MODE=true 로 구동할 것.
KRAI_PUBLIC_MODE=false

# ── Google OAuth (Client ID) ──
# Google Cloud Console → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션).
# 승인된 자바스크립트 원본에 http://127.0.0.1:4174 (모바일 PWA) 를 추가해야 함.
# 콤마로 여러 ID 허용(예: 웹,PWA,안드로이드). 비워두면 Google 로그인 비활성화.
GOOGLE_CLIENT_ID=

# ── 데이터베이스 ──
# None(기본) → SQLite 파일(.gospel.db). Postgres 전환 시 postgresql://... URL 설정.
# 2026-07-15부터 config.py(database_url)에 매핑 — db.py가 settings.database_url 사용.
DATABASE_URL=

# ── uvicorn 워커 수 (4vCPU 박스 권장 2, 2vCPU 박스는 1) ──
UVICORN_WORKERS=2

# ── Web Push (VAPID) ── 2026-07-15부터 config.py(vapid_*)에 매핑
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# PUSH_ENABLED=true 일 때만 매일 PUSH_HOUR_KST 시(KST) 말씀 발송 스케줄러 가동
PUSH_ENABLED=false
PUSH_HOUR_KST=7

# ── Token Quota (토큰 할당량) ── 2026-07-15부터 config.py(token_quota_*)에 매핑 + token_service 실제 강제
# false(기본) → 무제한. true → 일/월간 할당량 강제(소진 시 채팅 429).
TOKEN_QUOTA_ENABLED=false
TOKEN_QUOTA_DEFAULT=20000
TOKEN_QUOTA_MONTHLY=200000

# ── Welcome / UI ── 2026-07-15부터 config.py(welcome_verse)에 매핑. GET /mobile/verse/daily 로 노출.
WELCOME_VERSE=요한복음 3:16 — 하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 그를 믿는 자마다 멸망하지 않고 영생을 얻게 하려 하심이라

DATA_DIR=data/documents
LOG_LEVEL=INFO

# ---- PortOne 결제 게이트웨이 (V2) ----
# store_id / api_secret 는 PortOne 콘솔에서 발급. api_secret 는 서버 전용(절대 클라이언트 노출 금지).
# channel_key 는 결제 수단(카드/간편결제 등)별로 PortOne 콘솔에서 발급 — 미설정 시 결제 생성 실패.
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PORTONE_API_BASE=https://api.portone.io
# 웹훅 서명 검증용 시크릿(콘솔에 등록한 값). 비우면 검증 생략.
PORTONE_WEBHOOK_SECRET=
