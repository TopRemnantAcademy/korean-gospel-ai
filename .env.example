LLM_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true
# 비우면 gemini 실패 시 키가 있는 openai/claude/ollama 순으로 재시도
LLM_FALLBACK_CHAIN=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat


EMBEDDER=kure
EMBEDDER_LIST=kure

QDRANT_URL=local:./.qdrant_local
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=gospel

RERANKER=bge_m3

RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3


POLICY_ENABLED=true
POLICY_RULES_PATH=data/eval/policy_rules.yaml

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

APP_PASSWORD=
ADMIN_API_KEY=change-me
DIFY_API_KEY=change-me

DATA_DIR=data/documents
LOG_LEVEL=INFO
