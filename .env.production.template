# =========================================================
# 한국어  - Production Environment Template
# =========================================================
# ⚠️  THIS FILE: .env.production (COPY + FILL IN SECRETS!)
# ⚠️  NEVER COMMIT ACTUAL SECRETS TO GIT
# =========================================================

# ---- LLM (보유 키: tencent, nvidia, gemini — openai/claude 는 사용 안 함) ----
LLM_PROVIDER=tencent
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
TENCENT_API_KEY=YOUR_TENCENT_API_KEY_HERE
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE

# ---- Fallback LLM ----
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_CHAIN=tencent,nvidia,gemini

# ---- Embedder (Production: KURE-v1 원문 + bge-m3 중국어 이중) ----
# ⚠️ hf_inference 로 바꾸면 로컬 임베더 모델(1.3GB) 미로드 → 메모리 여유 확보.
#    단 HF_TOKEN 이 필요. 박스 메모리가 빠듯하면 아래 2줄 주석 해제:
# EMBEDDER=hf_inference
# EMBEDDER_LIST=hf_inference
EMBEDDER=kure
EMBEDDER_LIST=kure,bge_m3

# ---- Vector DB ----
# 옵션 A (권장, 단일 박스): compose 의 qdrant 컨테이너 사용 → 아래 주석 처리.
# 옵션 B (확장): Qdrant Cloud 사용 → 아래 줄 채우고 compose 에서 qdrant 서비스 제거.
# QDRANT_URL=https://your-cluster.qdrant.tech:6333
# QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE
QDRANT_COLLECTION_PREFIX=gospel_prod

# ---- Reranker (bge-m3 로컬 활성화 + fail-open/RAM 가드) ----
RERANKER=bge_m3

# ---- Retrieval Parameters ----
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# ---- Policy ----
POLICY_ENABLED=true
POLICY_RULES_PATH=data/eval/policy_rules.yaml

# ---- Langfuse (Production: ENABLE!) ----
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Auth Tokens (PRODUCTION: CHANGE ALL!) ----
APP_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
ADMIN_API_KEY=MUST_CHANGE_THIS_ADMIN_KEY
DIFY_API_KEY=YOUR_DIFY_API_KEY

# ---- Token Quota (Production: ENABLE!) ----
TOKEN_QUOTA_ENABLED=true
TOKEN_QUOTA_DEFAULT=100000  # per week
TOKEN_QUOTA_PREMIUM=500000

# ---- Rate Limiting (Production: ENABLE!) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# ---- Speed Optimization ----
SALVATION_DETECTION_ENABLED=true
CLASSIFY_INPUT_ENABLED=true

# ---- Ingest Pipeline ----
INGEST_NORMALIZE_ENABLED=true
INGEST_RESTRUCTURE_ENABLED=true
INGEST_CONTEXTUAL_ENABLED=true
INGEST_QUALITY_GATE_ENABLED=true
INGEST_CHUNK_TARGET_TOKENS=350
INGEST_CHUNK_MAX_TOKENS=512
INGEST_CHUNK_MIN_TOKENS=50

# ---- Welcome Verse ----
WELCOME_VERSE=하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 그를 믿는 자마다 멸망하지 않고 영생을 얻게 하려 하심이라
WELCOME_VERSE_REF=요한복음 3:16

# ---- Data & Logging ----
# 컨테이너 내 바인드 마운트(./data:/app/data) 와 일치시켜야 함 (Dockerfile ENV 와 동일)
DATA_DIR=/app/data/documents
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100

# ---- Qdrant Sparse (Production: ENABLE!) ----
QDRANT_SPARSE_ENABLED=true

# ---- 운영 환경 / 보안 (PRODUCTION 필수) ----
APP_ENV=prod
# /docs·/openapi.json 노출 차단 (운영 표준)
DOCS_ENABLED=false
# 8501 UI 공개 모드: true → 관리자 진입/페이지 차단(app.py/admin/lib/auth.py 게이트).
# 공개 배포 시 true, 관리자 허브(8502)는 별도 프로세스로 분리 운영.
KRAI_PUBLIC_MODE=true

# ---- uvicorn 워커 수 (4vCPU 박스 권장 2, 2vCPU 박스는 1) ----
UVICORN_WORKERS=2
